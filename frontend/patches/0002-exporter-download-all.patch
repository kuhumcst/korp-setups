+/**
+ * @file korp-setups (NorS, University of Copenhagen) addition.
+ *
+ * "All concordance lines" download: opens our exporter service (exporter/ in
+ * the korp-setups repository) with the parameters of the current KWIC
+ * request, so it can page through the whole result on the backend and
+ * stream a CSV. The service URL comes from the `exporter_url` setting;
+ * relative URLs resolve against the page URL. Without the setting, the
+ * menu option is not shown.
+ */
+import settings from "@/settings"
+import { KwicParams } from "./kwic_download"
+
+export const exporterUrl = (): string | undefined => settings["exporter_url"] || undefined
+
+export function openExporter(params: KwicParams, hits: number): void {
+    const base = exporterUrl()
+    if (!base) return
+    const url = new URL(base, location.href)
+    for (const [key, value] of Object.entries(params)) {
+        if (value === undefined || value === null) continue
+        url.searchParams.set(key, String(value))
+    }
+    url.searchParams.set("hits_display", String(hits))
+    window.open(url.toString(), "_blank")
+}
